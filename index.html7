<script>
function gradeQuiz(button){
  const quiz = button.closest('.quiz');
  const questions = quiz.querySelectorAll('.q');
  let score = 0;
  questions.forEach((q, index)=>{
    const correct = q.dataset.answer;
    const selected = q.querySelector('input[type="radio"]:checked');
    q.querySelectorAll('label').forEach(l=>{
      l.style.borderColor = '#d8eaff';
      l.style.background = '#fff';
    });
    if(selected){
      const label = selected.closest('label');
      if(selected.value === correct){
        score++;
        label.style.borderColor = '#56b883';
        label.style.background = '#eafff1';
      }else{
        label.style.borderColor = '#e86c8b';
        label.style.background = '#fff0f4';
        const correctInput = q.querySelector('input[value="'+correct+'"]');
        if(correctInput){
          const correctLabel = correctInput.closest('label');
          correctLabel.style.borderColor = '#56b883';
          correctLabel.style.background = '#eafff1';
        }
      }
    }
  });
  const result = quiz.querySelector('.result');
  result.textContent = 'النتيجة: ' + score + ' من ' + questions.length + (score === questions.length ? ' — ممتاز!' : ' — راجع الإجابات المظللة بالأخضر.');
}

function updateProgress(){
  const checks = Array.from(document.querySelectorAll('.progress-check'));
  const done = checks.filter(c=>c.checked).length;
  const percent = checks.length ? Math.round(done/checks.length*100) : 0;
  document.getElementById('progressText').textContent = percent + '%';
  document.getElementById('progressFill').style.width = percent + '%';
  localStorage.setItem('readingProgramChecks', JSON.stringify(checks.map(c=>c.checked)));
}
function loadProgress(){
  const saved = JSON.parse(localStorage.getItem('readingProgramChecks') || '[]');
  document.querySelectorAll('.progress-check').forEach((c,i)=>{
    c.checked = !!saved[i];
    c.addEventListener('change', updateProgress);
  });
  updateProgress();
}
function resetProgress(){
  localStorage.removeItem('readingProgramChecks');
  document.querySelectorAll('.progress-check').forEach(c=>c.checked=false);
  updateProgress();
}
document.addEventListener('DOMContentLoaded', loadProgress);
</script>

